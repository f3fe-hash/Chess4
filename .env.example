LICHESS_TOKEN=replace_with_lichess_bot_token
GROQ_API_KEY=replace_with_groq_api_key

# The host machine's loopback, shared by the Lichess container on Linux.
UCI_HOST=127.0.0.1
UCI_PORT=8080

TRAINING_POSITIONS=10000
TRAINING_DEPTH=16
TRAINING_MIN_PLY=16
TRAINING_MAX_PLY=100
TRAINING_SAMPLE_RATE=0.10
TRAINING_CHECKPOINT_GAMES=100
TRAINING_THREADS=4
TRAINING_HASH_MB=512
TRAINING_CPUS=2.5
TRAINING_SEED=12345